{
  "schema": 1,
  "id": "craft",
  "name": {
    "en": "Craft",
    "fr": "Craft"
  },
  "description": {
    "en": "A pixel-art world of cubes: square corners, bevelled stone buttons like a game menu, a grass-green accent, a sunny pixel landscape by day and a starry night after dark.",
    "fr": "Un monde de cubes en pixel art : coins carrés, boutons en pierre biseautés comme un menu de jeu, accent vert herbe, paysage pixel ensoleillé le jour et nuit étoilée le soir."
  },
  "author": "Romain Maxxing",
  "version": "1.0.0",
  "homepage": "https://github.com/romainmaxxing/harnessmaxxing-theme-craft",
  "base": "glass",
  "wallpaper": "wallpaper.webp",
  "wallpaper_dark": "wallpaper-dark.webp",
  "logo": "logo.png",
  "preview": "preview.png",
  "options": {
    "mode": "system",
    "font": "jetbrainsui",
    "mono": "jetbrains",
    "density": "comfortable"
  },
  "light": {
    "sf-h": 95,
    "sf-c": 0.006,
    "l-frame": 0.7,
    "l-list": 0.78,
    "l-content": 0.86,
    "l-card": 0.91,
    "l-float": 0.94,
    "l-accent": 0.8,
    "foreground": "#1b1b1b",
    "secondary-foreground": "#1b1b1b",
    "accent-foreground": "#1b1b1b",
    "muted-foreground": "#3d3d3d",
    "border": "oklch(0 0 0 / 30%)",
    "input": "oklch(0 0 0 / 40%)",
    "sidebar-border": "oklch(0 0 0 / 28%)",
    "primary": "#3c8527",
    "primary-foreground": "#ffffff",
    "ring": "#ffffff",
    "destructive": "#b02e26",
    "destructive-foreground": "#ffffff",
    "success": "#3c8527",
    "warning": "#8a5a00",
    "radius": "0px",
    "glass-blur": "6px",
    "glass-edge": "oklch(1 0 0 / 0.55)",
    "shadow-panel": "0 0 0 2px rgb(0 0 0 / 55%), 4px 4px 0 rgb(0 0 0 / 22%)",
    "shadow-pop": "0 0 0 2px rgb(0 0 0 / 80%), 6px 6px 0 rgb(0 0 0 / 30%)"
  },
  "dark": {
    "sf-h": 95,
    "sf-c": 0.006,
    "l-frame": 0.16,
    "l-list": 0.2,
    "l-content": 0.235,
    "l-card": 0.29,
    "l-float": 0.31,
    "l-accent": 0.36,
    "foreground": "#f4f4f4",
    "secondary-foreground": "#ffffff",
    "accent-foreground": "#ffffff",
    "muted-foreground": "#b4b4b4",
    "border": "oklch(1 0 0 / 16%)",
    "input": "oklch(1 0 0 / 26%)",
    "sidebar-border": "oklch(0 0 0 / 60%)",
    "primary": "#3c8527",
    "primary-foreground": "#ffffff",
    "ring": "#ffffff",
    "destructive": "#b02e26",
    "destructive-foreground": "#ffffff",
    "success": "#5cb83a",
    "warning": "#f0b232",
    "radius": "0px",
    "glass-blur": "6px",
    "glass-edge": "oklch(1 0 0 / 0.18)",
    "shadow-panel": "0 0 0 2px rgb(0 0 0 / 85%), 4px 4px 0 rgb(0 0 0 / 40%)",
    "shadow-pop": "0 0 0 2px rgb(0 0 0 / 95%), 6px 6px 0 rgb(0 0 0 / 45%)"
  },
  "css": [
    "& .mx-shell aside[data-testid='sidebar'].mx-frame { background: color-mix(in oklch, var(--sidebar) 70%, transparent); }",
    "& .mx-shell .mx-list.mx-list { --list-glass: color-mix(in oklch, var(--list) 84%, transparent); }",
    "&:not([data-compact]) .mx-content { background: color-mix(in oklch, var(--background) 92%, transparent); }",
    "& .mx-lg { --lg-fill: color-mix(in oklch, var(--card) 94%, transparent); }",
    "& :is(.mx-lg-btn, button.bg-primary, a.bg-primary, button.bg-destructive) {",
    "  box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.3), inset -2px -3px 0 rgb(0 0 0 / 0.35), 0 0 0 2px rgb(0 0 0 / 0.85);",
    "  transition: box-shadow 0.08s, background-color 0.08s;",
    "}",
    "& :is(.mx-lg-btn, button.bg-primary, a.bg-primary, button.bg-destructive):hover:not(:disabled) {",
    "  box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.35), inset -2px -3px 0 rgb(0 0 0 / 0.35), 0 0 0 2px rgb(255 255 255 / 0.95);",
    "}",
    "& :is(.mx-lg-btn, button.bg-primary, a.bg-primary, button.bg-destructive):active:not(:disabled) {",
    "  box-shadow: inset -2px -2px 0 rgb(255 255 255 / 0.2), inset 2px 3px 0 rgb(0 0 0 / 0.4), 0 0 0 2px rgb(255 255 255 / 0.95);",
    "}",
    "& :is(button.bg-primary, a.bg-primary, button.bg-destructive) { text-shadow: 2px 2px 0 rgb(0 0 0 / 0.45); }",
    "& .mx-lg:not(:has(textarea)) {",
    "  box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.12), inset -2px -2px 0 rgb(0 0 0 / 0.25), 0 0 0 2px rgb(0 0 0 / 0.6);",
    "}",
    "& .mx-lg:has(textarea) {",
    "  box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.35), inset -2px -2px 0 rgb(255 255 255 / 0.12), 0 0 0 2px rgb(0 0 0 / 0.75);",
    "}",
    "& :is(h1, h2, h3) { letter-spacing: 0.02em; }",
    "&.dark :is(h1, h2, h3) { text-shadow: 2px 2px 0 rgb(0 0 0 / 0.5); }",
    "& ::selection { background: rgb(92 184 58 / 0.5); }",
    "& * { scrollbar-color: rgb(128 128 128 / 0.8) transparent; }"
  ]
}
